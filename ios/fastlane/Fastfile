# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

APP_STORE_CONNECT_KEY_ID = "B842TCUH7K"
APP_STORE_CONNECT_ISSUER_ID = "dff63a2a-d197-4f33-b324-0961d113c4f5"
APP_STORE_CONNECT_KEY_PATH = "./fastlane/AuthKey_B842TCUH7K.p8"

XCODE_WORKSPACE = "BetaWork.xcworkspace"
XCODE_SCHEME = "BetaWork"
BUILD_OUTPUT_DIR = "./build"
BUILD_OUTPUT_NAME = "BetaWork.ipa"

platform :ios do
  desc "Release the app to the App Store"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: APP_STORE_CONNECT_KEY_ID,
      issuer_id: APP_STORE_CONNECT_ISSUER_ID,
      key_filepath: APP_STORE_CONNECT_KEY_PATH,
      in_house: false
    )

    # Provisioning – pass the API key so it never falls back to interactive login.
    cert(api_key: api_key)
    sigh(api_key: api_key, force: true)

    # Handles the "no TestFlight builds yet" case gracefully.
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      initial_build_number: 0,
      live: false
    )
    increment_build_number(
      xcodeproj: "BetaWork.xcodeproj",
      build_number: latest_build + 1
    )

    build_app(
      workspace: XCODE_WORKSPACE,
      scheme: XCODE_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: BUILD_OUTPUT_DIR,
      output_name: BUILD_OUTPUT_NAME,
      include_bitcode: false,
      include_symbols: true,
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_app_store(
      api_key: api_key,
      ipa: "#{BUILD_OUTPUT_DIR}/#{BUILD_OUTPUT_NAME}",
      platform: "ios",
      skip_metadata: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end

  desc "Upload an existing IPA to App Store Connect"
  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id: APP_STORE_CONNECT_KEY_ID,
      issuer_id: APP_STORE_CONNECT_ISSUER_ID,
      key_filepath: APP_STORE_CONNECT_KEY_PATH,
      in_house: false
    )

    upload_to_app_store(
      api_key: api_key,
      ipa: "./BetaWork.ipa",
      platform: "ios",
      skip_metadata: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end
end
